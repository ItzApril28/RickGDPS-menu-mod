{
	"geode": "5.8.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "itzapril28.bettervisual-and-audio",
	"name": "RickGdps Menu Mod",
	"version": "v1.4.6-beta.1",
	"early-load": true,
	"load-priority": -4000,
	"developer": "RickGdps",
	"description": "Enhanced visuals, dynamic resolution scaling, super-sampling, custom shaders, studio audio DSP, and a custom GD-styled settings UI for Geometry Dash.",
	"tags": [
		"universal",
		"enhancement",
		"performance",
		"customization"
	],
	"links": {
		"community": "https://discord.gg/E8f6D6XqbW",
		"source": "https://github.com/ItMe12s/BetterVisuals"
	},
	"resources": {
		"sprites": [
			"resources/*.png"
		],
		"files": [
			"resources/*.fnt"
		]
	},
	"settings": {
		"title-master": {
			"type": "title",
			"name": "Master Controls"
		},
		"enabled": {
			"type": "bool",
			"name": "Enable Mod",
			"description": "Master toggle for all visual post-processing effects.",
			"default": true
		},
		"enable-fun": {
			"type": "bool",
			"name": "Enable Stylized & Fun Shaders",
			"description": "Master toggle for creative, retro, and cinematic shader effects.",
			"default": true,
			"enable-if": "enabled"
		},
		"global-shader-enabled": {
			"type": "bool",
			"name": "Global Scene Shaders",
			"description": "Apply selected visual effects across all scenes including menus and creator layers (default applies only during gameplay).",
			"default": false,
			"enable-if": "enabled"
		},

		"title-presets": {
			"type": "title",
			"name": "Preset Profiles"
		},
		"performance-preset": {
			"type": "string",
			"name": "Performance Profile",
			"description": "Quick performance configuration presets.",
			"default": "Custom",
			"one-of": [
				"Custom",
				"Max FPS",
				"Balanced",
				"Visual Quality",
				"Cinematic"
			],
			"enable-if": "enabled"
		},
		"effect-preset": {
			"type": "string",
			"name": "Combined Effect Theme",
			"description": "Ready-to-use aesthetic theme combinations.",
			"default": "Custom",
			"one-of": [
				"Custom",
				"Cyberpunk",
				"Retro",
				"Cinema",
				"Dreamscape",
				"Comic",
				"Noir",
				"Arcade",
				"Ethereal",
				"Glitch",
				"RTX",
				"Nostalgic",
				"Deep Water"
			],
			"enable-if": "enable-fun"
		},
		"bloom-preset": {
			"type": "string",
			"name": "Bloom Profile",
			"description": "Pre-tuned bloom thresholds, intensities, and blur spreads. Nature, Butter Glow, Nostalgic Bloom and Memories are the v1.4.6 profiles.",
			"default": "Custom",
			"one-of": [
				"Custom",
				"Soft",
				"Dreamy",
				"Neon",
				"Sunset",
				"Frost",
				"Fire",
				"Noir",
				"Pastel",
				"Intense",
				"Nature",
				"Butter Glow",
				"Nostalgic Bloom",
				"Memories"
			],
			"enable-if": "enable-fun"
		},

		"title-resolution": {
			"type": "title",
			"name": "Display & Resolution Scaling"
		},
		"drs-enabled": {
			"type": "bool",
			"name": "Dynamic Render Scaling (DRS)",
			"description": "Automatically adjusts internal resolution in real-time to preserve target frame rate during complex level sections.",
			"default": false,
			"enable-if": "enabled"
		},
		"drs-target-fps": {
			"type": "string",
			"name": "DRS Target FPS",
			"description": "Target framerate threshold for Dynamic Render Scaling.",
			"default": "Screen Refresh Rate",
			"one-of": [
				"Screen Refresh Rate",
				"60 FPS",
				"120 FPS",
				"144 FPS",
				"165 FPS",
				"240 FPS",
				"360 FPS",
				"Custom"
			],
			"enable-if": "drs-enabled"
		},
		"drs-custom-fps": {
			"type": "float",
			"name": "DRS Custom Target FPS",
			"description": "Custom framerate target when DRS Target FPS is set to Custom.",
			"default": 144.0,
			"min": 30.0,
			"max": 1000.0,
			"control": {
				"arrows": true,
				"arrow-step": 10.0,
				"slider": true,
				"slider-step": 1.0
			},
			"enable-if": "drs-enabled"
		},
		"drs-min-scale": {
			"type": "float",
			"name": "DRS Minimum Scale",
			"description": "Lowest internal resolution scale DRS can drop to under heavy load.",
			"default": 0.5,
			"min": 0.25,
			"max": 1.0,
			"control": {
				"arrows": true,
				"arrow-step": 0.05,
				"slider": true,
				"slider-step": 0.01
			},
			"enable-if": "drs-enabled"
		},
		"drs-max-scale": {
			"type": "float",
			"name": "DRS Maximum Scale",
			"description": "Highest resolution scale DRS will upscale up to when framerate is stable.",
			"default": 1.0,
			"min": 0.5,
			"max": 2.0,
			"control": {
				"arrows": true,
				"arrow-step": 0.05,
				"slider": true,
				"slider-step": 0.01
			},
			"enable-if": "drs-enabled"
		},
		"drs-sensitivity": {
			"type": "string",
			"name": "DRS Response Sensitivity",
			"description": "How quickly resolution adapts to sudden frametime spikes.",
			"default": "Normal",
			"one-of": [
				"Smooth (Slow)",
				"Normal",
				"Aggressive (Fast)"
			],
			"enable-if": "drs-enabled"
		},
		"render-scale": {
			"type": "float",
			"name": "Static Render Scale",
			"description": "Render resolution multiplier (0.25x to 2.0x SSAA) used when DRS is disabled.",
			"default": 1.0,
			"min": 0.25,
			"max": 2.0,
			"control": {
				"arrows": true,
				"arrow-step": 0.05,
				"slider": true,
				"slider-step": 0.01
			},
			"enable-if": "enabled"
		},
		"upscale-method": {
			"type": "string",
			"name": "Upscaling / Reconstruction Method",
			"description": "Filter used to reconstruct the final image onto your screen.",
			"default": "FSR 1",
			"one-of": [
				"Nearest",
				"FSR 1"
			],
			"enable-if": "enabled"
		},

		"title-aa-sharpening": {
			"type": "title",
			"name": "Anti-Aliasing & Sharpening"
